class Solution {
    public int romanToInt(String s) {
       
       HashMap<Character,Integer> roman = new HashMap<>();
       roman.put('I',1);
       roman.put('V',5);
       roman.put('X',10);
       roman.put('L',50);
       roman.put('C',100);
       roman.put('D',500);
       roman.put('M',1000);
    
       
       int total=0;
       int j=s.length();
       if(j==1){
            total+=roman.get(s.charAt(0));
        }

        else{


            for(int i=j-2; i>=0;i--){
                
                        
                        
                    
                int left=roman.get(s.charAt(i));
                int right=roman.get(s.charAt(j-1));

                if(left<right){
                    total +=(right-left);
                    i-=1;
                    j-=1;
                }
                            
                else if(left >= right){
                    total+=(right);
                                
                                
                    }

                    j--;
                    if(j==1){
                    total+=roman.get(s.charAt(0));
                    }
                        
                                
            }

            
        }
        return total;
    }
}
