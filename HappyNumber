class Solution {
    public boolean isHappy(int n) {
      int slow=n;
      int fast=sumsquares(n);

      while(fast!=1 && slow!=fast){
            slow=sumsquares(slow);
            fast=sumsquares(sumsquares(fast));
      }
      return fast==1;
    }


    public int sumsquares(int n){
        int sum=0;
        while(n>0){
            int remainder=n%10;
            sum+=remainder*remainder;
            n/=10;
        }
        return sum;
    }

}
