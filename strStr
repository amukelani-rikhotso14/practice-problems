class Solution {
    public int strStr(String haystack, String needle) {
        int len1=haystack.length();
        int len2=needle.length();

        if(len1 < len2){
            return -1;
        }

        else{
            
            for(int i=0; i<len1;i++){
                for(int j=0 ;j<=len2;j++){
                    if(i<=j){
                        String s=haystack.substring(i,j);
                        System.out.println(s);
                        if(s.equals(needle)){
                            return i;
                        }
                    }
                    else{
                        return -1;
                    }
                
                    
                }
            }
            return -1;
        }
    }
}
