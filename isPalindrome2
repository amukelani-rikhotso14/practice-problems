class Solution {
    public boolean isPalindrome2(String s) {
        int len= s.length();
        StringBuilder sb = new StringBuilder();
     
        
        for (int i=0; i<len ;i++){
            char c= s.charAt(i);
            
            int num=Math.abs(Character.toLowerCase(c) - 'z' + 1);
        
            
            if(num<=26 || (c>='0' && c<='9') ){
            sb.append(Character.toLowerCase(c));
            }
                    
        }

        String str = sb.toString();
        System.out.println(str);
        int l=str.length()-1;
            
        for(int k=0 ; k<l ;k++){
            if(str.charAt(k) != str.charAt(l)){
                 return false;
            }
            else{
                l--;
            }
        }
        return true;
        
    }
}
