class Solution {
    public boolean isPalindrome(int x) {
        String num=x+"";
        StringBuilder sb=new StringBuilder();
        int len=num.length();

        for(int i=len-1; i>=0 ; i--){
            char c =num.charAt(i);
            sb.append(c);
        }

        String palindrome= sb.toString();
        if (palindrome.equals(num)){
            return true;

        }
        else{
        return false;
        }
    }
}
